# Local development overrides — committed to git (no secrets here).
# This file is loaded automatically when NODE_ENV=development (i.e. `pnpm dev`).
# For personal overrides (e.g. a different local Postgres user/password), use
# .env.development.local which is gitignored.

NODE_ENV=development
# No local Postgres installed — intentionally using the dev Supabase instance.
# Remove this line and add DATABASE_URL to .env.development.local once you have local Postgres.
ALLOW_REMOTE_DB_IN_DEV=true
# When you have a local Postgres, add to .env.development.local (gitignored):
#   ALLOW_REMOTE_DB_IN_DEV=false
#   DATABASE_URL=postgresql://user:pass@localhost:5432/financialapp
#   DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
CORS_ORIGIN=http://localhost:5173
AUTH_PROVIDER=local
